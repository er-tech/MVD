{
  "name": "@mvd/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "smith run build",
    "lint": "smith run lint",
    "test": "smith run test",
    "typecheck": "smith run typecheck",
    "affected": "smith run lint typecheck test build --affected",
    "graph": "smith graph",
    "release:preview": "smith release --dry-run",
    "prepare": "husky",
    "format": "eslint . --fix --cache",
    "lint:workspace": "eslint . --cache --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"python-packages/**\" --ignore-pattern package-lock.json"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@monosmith/eslint-config": "^1.1.0",
    "@monosmith/jest-preset": "^2.0.0-beta.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "adm-zip": "^0.6.1",
    "babel-jest": "~30.5.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.3.0",
    "jest-util": "~30.5.1",
    "jiti": "2.7.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "zod": "^4.6.6",
    "fast-uri": "^3.1.9",
    "qs": "^6.16.1",
    "follow-redirects": "^1.16.2",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "brace-expansion@4.0.0 - 5.0.8": "^5.0.9",
    "@emnapi/core": "$@emnapi/core",
    "@emnapi/runtime": "$@emnapi/runtime",
    "ts-jest": {
      "handlebars": "^4.7.10"
    },
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
